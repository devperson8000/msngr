VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Preferred: server-only Cloudflare Realtime TURN configuration.
# This ID is already the endpoint default. Supply the API token securely in Vercel.
# CLOUDFLARE_TURN_KEY_ID=8733114e9477d352db7d0f2d85958fdd
# CLOUDFLARE_TURN_API_TOKEN=
# Never prefix the Cloudflare API token with VITE_.

# Server-only Vercel variables for a coturn REST-compatible relay.
# Supply TURN_SHARED_SECRET securely in Vercel; never prefix it with VITE_.
# TURN_URLS=turn:relay.example.com:3478,turns:relay.example.com:5349?transport=tcp
# TURN_SHARED_SECRET=

# Optional development-only ICE override; use disposable short-lived credentials.
# VITE_WEBRTC_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]
